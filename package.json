{
  "name": "opstalia",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "OPSTALIA 1.0 — an independent, unclassified declassified-records search engine for official U.S. Government repositories.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "npm run build && playwright test",
    "test:security": "vitest run tests/security",
    "test:a11y": "npm run build && playwright test tests/e2e/accessibility.spec.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "worker:secret": "wrangler secret put NARA_API_KEY --config worker/wrangler.toml",
    "worker:secret:nara": "wrangler secret put NARA_API_KEY --config worker/wrangler.toml",
    "worker:secret:govinfo": "wrangler secret put GOVINFO_API_KEY --config worker/wrangler.toml",
    "worker:secret:rate-limit": "wrangler secret put RATE_LIMIT_SALT --config worker/wrangler.toml",
    "audit": "npm audit --audit-level=high",
    "secret:scan": "node scripts/secret-scan.mjs",
    "indexes:frus": "node scripts/build-frus-index.mjs",
    "indexes:iscap": "node scripts/build-iscap-index.mjs",
    "indexes:ndc": "node scripts/build-ndc-index.mjs",
    "indexes:jfk-2025": "node scripts/build-jfk-2025-index.mjs",
    "indexes:refresh": "npm run indexes:frus && npm run indexes:iscap && sleep 10 && npm run indexes:ndc && sleep 10 && npm run indexes:jfk-2025"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.394",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260905.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "wrangler": "4.129.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
