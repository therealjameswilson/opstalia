# Public frontend configuration only. Never put an API key in a VITE_ variable.
VITE_API_BASE=https://opstalia-api.YOUR-WORKERS-SUBDOMAIN.workers.dev

# Worker secrets are installed with Wrangler, never written here:
# wrangler secret put NARA_API_KEY --config worker/wrangler.toml
# wrangler secret put GOVINFO_API_KEY --config worker/wrangler.toml
# wrangler secret put RATE_LIMIT_SALT --config worker/wrangler.toml
# NARA_API_KEY=installed-with-wrangler-only
# GOVINFO_API_KEY=installed-with-wrangler-only
# RATE_LIMIT_SALT=installed-with-wrangler-only

# Non-secret Worker variable. Set to the exact production frontend origin.
FRONTEND_ORIGIN=https://therealjameswilson.github.io
